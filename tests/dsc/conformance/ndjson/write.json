{
  "suite": "ndjson-write",
  "description": "Message record -> one NDJSON line (the per-day message file format).",
  "normative": true,
  "compare": {
    "method": "Serialize the input record to one line. Compare as JSON values (key order and whitespace are free; the line MUST NOT contain a newline). Floats compare with the tolerance; keys absent in expected MUST be absent.",
    "float_abs_tolerance": 1e-06,
    "float_abs_tolerance_overrides": {
      "pos.lat": 1e-06,
      "pos.lon": 1e-06,
      "area.lat": 1e-06,
      "area.lon": 1e-06,
      "note": "Coordinates MUST be written with at least 6 decimal places (DSC positions are whole minutes, e.g. 54.583333)."
    }
  },
