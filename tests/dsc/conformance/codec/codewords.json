{
  "suite": "codewords",
  "description": "The 10-bit error-detecting code (ITU-R M.493 sec 3): every symbol 0..127 with its codeword, plus the DX/RX phasing and dot-pattern codewords.",
  "normative": true,
  "compare": {
    "method": "Exact. Codeword bit i is the i-th bit transmitted. Bits 0..6 = symbol value, LSB first; bits 7..9 = number of 0 bits among bits 0..6, MSB first."
  },
  "special": {
    "dx_codeword": 637,
    "dot_pattern_codeword": 682,
    "rx_codewords_for_symbols_104_to_111": [232, 873, 874, 363, 876, 365, 366, 623]
